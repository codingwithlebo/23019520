@model List<EventDto>
@{
    ViewData["Title"] = "My events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="rd-heading mb-0">My events</h1>
    <a class="btn btn-primary" asp-action="Create">Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <p class="h5">No events yet.</p>
        <a class="btn btn-primary" asp-action="Create">Create your first event</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Location</th><th>Type</th><th class="text-center">Enrolments</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.OrderBy(e => e.Date))
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id">@ev.Name</a></td>
                        <td>@Format.LongDate(ev.Date)</td>
                        <td>@ev.Location</td>
                        <td>@ev.EventType &middot; @Format.Distance(ev.DistanceKm)</td>
                        <td class="text-center"><span class="badge rd-distance">@ev.EnrolmentCount</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@ev.Id">Edit</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Categories" asp-route-eventId="@ev.Id">Categories</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Enrolments" asp-route-eventId="@ev.Id">Enrolments</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Results" asp-route-eventId="@ev.Id">Results</a>
                            <form asp-action="Delete" asp-route-id="@ev.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? Its categories, enrolments and results will be removed too.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
