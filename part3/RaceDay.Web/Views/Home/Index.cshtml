@model HomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
}
<section class="rd-hero mb-4">
    <h1 class="rd-heading">Find your next <em>race</em></h1>
    <p class="mb-0">Browse upcoming runs, walks and cycle events, pick your category and get on the start line.</p>
</section>

<form method="get" asp-controller="Home" asp-action="Index" class="card rd-filter mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="Search">Search</label>
                <input class="form-control" id="Search" name="Search" value="@Model.Filter.Search" placeholder="Event name or location" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="Type">Type</label>
                <select class="form-select" id="Type" name="Type">
                    <option value="">All types</option>
                    @foreach (var type in new[] { "Run", "Walk", "Cycle" })
                    {
                        <option value="@type" selected="@(Model.Filter.Type == type)">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="MinDistance">Min km</label>
                <input class="form-control" type="number" step="0.1" min="0" id="MinDistance" name="MinDistance" value="@Model.Filter.MinDistance" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="MaxDistance">Max km</label>
                <input class="form-control" type="number" step="0.1" min="0" id="MaxDistance" name="MaxDistance" value="@Model.Filter.MaxDistance" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="IncludePast" name="IncludePast" value="true" checked="@Model.Filter.IncludePast" />
            <label class="form-check-label" for="IncludePast">Include events that have already taken place</label>
        </div>
    </div>
</form>

@if (Model.Error is not null)
{
    <div class="alert alert-warning">@Model.Error</div>
}
else if (Model.Events.Count == 0)
{
    <div class="rd-empty">
        <p class="h5">No events match right now.</p>
        <p class="text-muted mb-0">Try clearing the filters, or check back soon for new races.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col">@await Html.PartialAsync("_EventCard", ev)</div>
        }
    </div>
}
