@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card rd-form-card">
            <div class="card-body p-4">
                <h1 class="rd-heading h3">Create your account</h1>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label d-block">I am a...</label>
                        <div class="btn-group w-100" role="group" aria-label="Role">
                            <input type="radio" class="btn-check" name="Role" id="roleParticipant" value="Participant" checked="@(Model.Role != "Organiser")" />
                            <label class="btn btn-outline-primary" for="roleParticipant">Participant</label>
                            <input type="radio" class="btn-check" name="Role" id="roleOrganiser" value="Organiser" checked="@(Model.Role == "Organiser")" />
                            <label class="btn btn-outline-primary" for="roleOrganiser">Organiser</label>
                        </div>
                        <div class="form-text">Participants enter races. Organisers create and run events.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="OrganiserCode" class="form-label"></label>
                        <input asp-for="OrganiserCode" class="form-control" autocomplete="off" />
                        <div class="form-text">Only needed if you are registering as an Organiser.</div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Create account</button>
                </form>
                <p class="text-center mt-3 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
            </div>
        </div>
    </div>
</div>
