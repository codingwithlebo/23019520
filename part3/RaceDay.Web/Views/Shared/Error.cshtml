@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="text-center py-5">
    <div class="rd-error-code">@Model.Code</div>
    <h1 class="rd-heading">@Model.Title</h1>
    <p class="lead text-muted">@Model.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to events</a>
</div>
