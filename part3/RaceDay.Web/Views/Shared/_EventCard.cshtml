@model EventDto
<div class="card rd-event-card h-100">
    @if (Model.BannerUrl is not null)
    {
        <img class="rd-card-img" src="@Url.Action("EventBanner", "Media", new { id = Model.Id })" alt="Banner for @Model.Name" />
    }
    else
    {
        <div class="rd-card-img rd-card-placeholder"><span>@Format.TypeEmoji(Model.EventType)</span></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="mb-2"><span class="badge rd-type">@Model.EventType</span> <span class="badge rd-distance">@Format.Distance(Model.DistanceKm)</span></div>
        <h2 class="h5 rd-card-title">@Model.Name</h2>
        <p class="text-muted small mb-1">@Format.LongDate(Model.Date)</p>
        <p class="text-muted small mb-3">@Model.Location</p>
        <a class="btn btn-primary mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">View details</a>
    </div>
</div>
